{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MTP query execution result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "batch_id", "client", "environment", "case_count", "cases"],
  "properties": {
    "schema_version": { "const": "context-router-mtp-query-result-v1" },
    "campaign_id": { "const": "panzhihua-mtp-test-query-2026-09" },
    "batch_id": { "type": "string", "pattern": "^batch-[0-9]{3}$" },
    "client": { "enum": ["cursor", "grok-heavy", "antigravity"] },
    "environment": { "const": "test" },
    "started_at": { "type": ["string", "null"] },
    "completed_at": { "type": ["string", "null"] },
    "case_count": { "type": "integer", "minimum": 1, "maximum": 20 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "interface_id", "method", "path", "status", "classification", "attempt_count", "parameter_generation", "request", "execution", "error"],
        "properties": {
          "case_id": { "type": "string", "pattern": "^mtp-read-[0-9]{4}$" },
          "interface_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "method": { "type": "string" },
          "path": { "type": "string" },
          "status": { "enum": ["completed", "failed", "skipped", "blocked"] },
          "classification": {
            "enum": ["non_empty_success", "valid_empty", "parameter_invalid", "auth_failed", "server_error", "timeout", "skipped_safety", "blocked"]
          },
          "attempt_count": { "type": "integer", "minimum": 0, "maximum": 2 },
          "parameter_generation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strategy", "confidence", "evidence", "assumptions"],
            "properties": {
              "strategy": { "enum": ["test_history", "other_history", "saved_params", "source", "schema", "value_mapping", "combined", "none"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidence": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } },
              "assumptions": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } }
            }
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address_name", "login_account_masked", "role_name", "path", "query", "body"],
            "properties": {
              "address_name": { "type": ["string", "null"] },
              "login_account_masked": { "type": ["string", "null"] },
              "role_name": { "type": ["string", "null"] },
              "path": { "type": ["object", "null"] },
              "query": { "type": ["object", "null"] },
              "body": { "type": ["object", "array", "null"] }
            }
          },
          "execution": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "task_id": { "type": ["integer", "null"] },
              "plan_id": { "type": ["string", "null"] },
              "execution_id": { "type": ["string", "null"] },
              "log_id": { "type": ["string", "null"] },
              "status_code": { "type": ["integer", "null"] },
              "business_code": { "type": ["string", "integer", "null"] },
              "business_success": { "type": ["boolean", "null"] },
              "business_message": { "type": ["string", "null"], "maxLength": 500 },
              "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
              "response_bytes": { "type": ["integer", "null"], "minimum": 0 },
              "response_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
              "data_shape": { "type": ["string", "null"], "maxLength": 120 },
              "result_count": { "type": ["integer", "null"], "minimum": 0 }
            }
          },
          "error": { "type": ["string", "null"], "maxLength": 500 }
        }
      }
    }
  }
}
