CONTEXT_ROUTER_RUNTIME_MODE=native
# 可选；脚本也会自动发现 Homebrew keg-only 的 node@22。
CONTEXT_ROUTER_NODE_HOME=/opt/homebrew/opt/node@22
# launchd 下工作空间脚本需要的额外工具目录，多个目录用冒号分隔。
# macOS 上存在 IntelliJ IDEA 时，Native 脚本会自动补充其内置 Maven 目录。
CONTEXT_ROUTER_HOST_TOOL_PATHS=
CONTEXT_ROUTER_WORKSPACE_ROOT=/Users/conchi/workforce
CONTEXT_ROUTER_WORKSPACE_MAPPING_FILE=/absolute/path/agent-context-router/.context-router/workspaces.local.yaml
CONTEXT_ROUTER_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/context_router
CONTEXT_ROUTER_PUBLIC_MCP_URL=http://127.0.0.1:49173/mcp
CONTEXT_ROUTER_INTERNAL_MCP_URL=http://127.0.0.1:49173/mcp
CONTEXT_ROUTER_SHARED_CONFIG_CENTER_BASE_URL=http://127.0.0.1:48080
CONTEXT_ROUTER_RUNTIME_ROOT=/absolute/path/agent-context-router/.runtime-runner
CONTEXT_ROUTER_RUNTIME_RUNNER_TOKEN_PATH=/absolute/path/agent-context-router/.runtime-runner/runner.token
CONTEXT_ROUTER_RUNTIME_DOCKER_SOCKET=/Users/USER/.docker/run/docker.sock
CONTEXT_ROUTER_RUNTIME_EXECUTION_ENABLED=false
CONTEXT_ROUTER_RUNTIME_RUNNER_API_ENABLED=true
CONTEXT_ROUTER_CONTROL_URL=http://127.0.0.1:49173
NEXT_PUBLIC_CONTEXT_ROUTER_API_URL=http://127.0.0.1:49173
CONTEXT_ROUTER_INTERNAL_API_URL=http://127.0.0.1:49173
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost
